  "item": [
    {
      "name": "Security & Keycloak",
      "item": [
        {
          "name": "Get Keycloak Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"gateway_auth_token\", jsonData.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "{{keycloak_client_id}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{keycloak_username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{keycloak_password}}",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid",
                  "type": "text"
                }
              ]
            },
            "url": "{{catalog_base}}/auth/realms/go-commerce/protocol/openid-connect/token",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{gateway_auth_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
